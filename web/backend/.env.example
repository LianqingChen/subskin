# SubSkin Backend 环境变量示例
# 复制为 .env 并填入实际配置

# 数据库连接 URL
# 开发：sqlite:///./data/subskin.db
# 生产 PostgreSQL：postgresql://user:password@localhost/subskin
DATABASE_URL=sqlite:///./data/subskin.db

# JWT 密钥（生产环境必须修改为随机字符串）
SECRET_KEY=your-secret-key-change-in-production

# Token 有效期
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 初始管理员账号
ADMIN_USER=admin
ADMIN_PASS=change-this-to-secure-password

# 短信配置
# log=开发模式(仅日志) / aliyun=阿里云短信(Dysms) / aliyun_auth=阿里云短信认证服务(DYPNS,推荐) / tencent=腾讯云短信
SMS_PROVIDER=log
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=

# 阿里云短信认证服务（aliyun_auth模式专用）
# 号码认证服务赠送签名和模板，无需自审签名
SMS_SIGN_NAME=速通互联验证码
SMS_TEMPLATE_CODE=100001
SMS_VERIFY_SCENE=  # 可选：验证场景ID，用于VerifySmsVerifyCode

# 阿里云短信（aliyun模式专用）
# SMS_SIGN_NAME=SubSkin
# SMS_TEMPLATE_CODE=您的短信模板CODE

# 腾讯云短信（tencent模式专用）
TENCENT_SMS_APP_ID=
TENCENT_SMS_TEMPLATE_ID=

# 邮件配置
EMAIL_PROVIDER=log  # log开发模式 / smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 微信开放平台配置（网站应用）
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
WECHAT_REDIRECT_URI=https://your-domain.com/api/oauth/wechat/callback

# 支付宝开放平台配置
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-rsa-private-key
ALIPAY_PUBLIC_KEY=your-rsa-public-key
ALIPAY_REDIRECT_URI=https://your-domain.com/api/oauth/alipay/callback

# 腾讯云短信配置
TENCENT_SMS_APP_ID=your-tencent-sms-app-id
TENCENT_SMS_TEMPLATE_ID=your-tencent-sms-template-id

# ============================================
# LLM / Embedding 配置
# 支持三种 Provider（按优先级排序）：
# 1. 阿里云百炼 DashScope（推荐，中文能力强）
# 2. 火山引擎 Volcengine
# 3. OpenAI
# ============================================

# 阿里云百炼 DashScope（优先使用）
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024

# 火山引擎 Volcengine（备选）
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_CHAT_ENDPOINT=
VOLCENGINE_EMBEDDING_ENDPOINT=

# OpenAI（备选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-3-small

# RAG 向量搜索开关（true=向量搜索+关键词，false=仅关键词）
RAG_USE_VECTOR=true