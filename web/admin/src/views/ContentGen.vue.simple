<template>
  <div class="content-gen-page">
    <n-page-header title="内容生成" />
    <p class="page-desc">管理 AI 生成内容的草稿、编辑与发布</p>

    <n-card style="margin-top: 24px" :bordered="false" class="action-card">
      <n-space>
        <n-button type="primary" @click="fetchDrafts">获取草稿</n-button>
        <n-button @click="generateContent">生成内容</n-button>
      </n-space>
    </n-card>

    <n-card style="margin-top: 16px" :bordered="false" class="table-card">
      <n-data-table
        :columns="columns"
        :data="drafts"
        :bordered="false"
        :single-line="false"
        :row-key="(row) => row.id"
        size="small"
      />
      <n-empty v-if="!loading && drafts.length === 0" description="暂无草稿" />
    </n-card>
  </div>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, h } from 'vue'
import {
  NPageHeader,
  NCard,
  NSpace,
  NButton,
  NDataTable,
  NEmpty,
  NTag,
  useMessage,
} from 'naive-ui'
import request from '@/api/request'

const message = useMessage()

interface DraftItem {
  id: number
  title: string
  category_name?: string
  status: string
  city?: string
  mood?: string
  created_at?: string
}

const drafts = ref<DraftItem[]>([])
const loading = ref(false)

const columns = computed(() => [
  { title: 'ID', key: 'id', width: 70 },
  { title: '标题', key: 'title' },
  { title: '分类', key: 'category_name' },
  {
    title: '状态',
    key: 'status',
    render(row: DraftItem) {
      return h(NTag, { type: row.status === 'published' ? 'success' : 'default', size: 'small' }, {
        default: () => row.status,
      })
    },
  },
  { title: '城市', key: 'city' },
  { title: '创建时间', key: 'created_at' },
])

async function fetchDrafts() {
  loading.value = true
  try {
    const res = await request.get<DraftItem[]>('/admin/content/drafts')
    drafts.value = Array.isArray(res.data) ? res.data : []
    message.success(`加载了 ${drafts.value.length} 条草稿`)
  } catch (err: any) {
    message.error(err?.response?.data?.detail || '获取失败')
  } finally {
    loading.value = false
  }
}

async function generateContent() {
  try {
    await request.post('/admin/content/generate?count=2')
    message.success('生成成功')
    await fetchDrafts()
  } catch (err: any) {
    message.error(err?.response?.data?.detail || '生成失败')
  }
}

onMounted(() => {
  fetchDrafts()
})
</script>

<style scoped>
.content-gen-page {
  padding: 0;
}
.page-desc {
  color: #94a3b8;
  margin-top: 8px;
  font-size: 14px;
}
.action-card {
  background-color: #1e293b;
}
.table-card {
  background-color: #1e293b;
}
</style>
