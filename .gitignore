# ─────────────────────────────────────────────
# Agent tool runtime artifacts (keep project clean)
# Each agent tool gets its own state dir but
# those should never be committed to git.
# Only AGENTS.md and hermes_plan/ are shared.
# ─────────────────────────────────────────────
.opencode/
.codegraph/
.claude/
.sisyphus/
.playwright-mcp/
.superpowers/

# Hermes agent runtime state
.hermes/

# ─────────────────────────────────────────────
# Large model / 3D binaries — must not bloat git
